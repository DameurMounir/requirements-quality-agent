{
  "$defs": {
    "AnalysisOrigin": {
      "enum": [
        "FIXTURE",
        "RULE",
        "OPENAI"
      ],
      "title": "AnalysisOrigin",
      "type": "string"
    },
    "AnalysisProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Effort"
        }
      },
      "required": [
        "adapter",
        "model",
        "reasoning_effort",
        "prompt_sha256",
        "configuration_sha256"
      ],
      "title": "AnalysisProvenance",
      "type": "object"
    },
    "EvidenceVerdict": {
      "enum": [
        "RESOLVED",
        "SOURCE_UNKNOWN",
        "SOURCE_CHANGED",
        "QUOTE_NOT_FOUND",
        "QUOTE_AMBIGUOUS"
      ],
      "title": "EvidenceVerdict",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "CANDIDATE",
        "VERIFIED",
        "NEEDS_REVIEW",
        "CONFIRMED",
        "REJECTED",
        "BLOCKED"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "IssueType": {
      "enum": [
        "AMBIGUOUS_TERM",
        "UNTESTABLE",
        "INCOMPLETE",
        "DUPLICATE",
        "CONTRADICTION",
        "NON_ATOMIC",
        "MISSING_ACCEPTANCE_CRITERIA",
        "UNDEFINED_TERM"
      ],
      "title": "IssueType",
      "type": "string"
    },
    "QualityScorecard": {
      "additionalProperties": false,
      "properties": {
        "blocked_findings": {
          "minimum": 0,
          "title": "Blocked Findings",
          "type": "integer"
        },
        "candidate_findings": {
          "minimum": 0,
          "title": "Candidate Findings",
          "type": "integer"
        },
        "items_with_open_questions": {
          "minimum": 0,
          "title": "Items With Open Questions",
          "type": "integer"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "total_items": {
          "minimum": 0,
          "title": "Total Items",
          "type": "integer"
        },
        "verified_findings": {
          "minimum": 0,
          "title": "Verified Findings",
          "type": "integer"
        }
      },
      "required": [
        "method_version",
        "total_items",
        "candidate_findings",
        "verified_findings",
        "blocked_findings",
        "items_with_open_questions"
      ],
      "title": "QualityScorecard",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RequirementKind"
        },
        "requirement_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "text",
        "source_span"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementKind": {
      "enum": [
        "FUNCTIONAL",
        "NON_FUNCTIONAL",
        "BUSINESS_RULE",
        "USER_STORY"
      ],
      "title": "RequirementKind",
      "type": "string"
    },
    "ResolvedCitation": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "exact_quote": {
          "title": "Exact Quote",
          "type": "string"
        },
        "quote_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Sha256"
        },
        "source_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "verdict": {
          "$ref": "#/$defs/EvidenceVerdict"
        }
      },
      "required": [
        "verdict",
        "source_id",
        "exact_quote"
      ],
      "title": "ResolvedCitation",
      "type": "object"
    },
    "RevisionProposal": {
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "original_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Text Sha256",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposed_text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Proposed Text",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "requirement_id",
        "original_text_sha256",
        "proposed_text",
        "finding_ids"
      ],
      "title": "RevisionProposal",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "exact_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Text Sha256",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "line_start",
        "line_end",
        "char_start",
        "char_end",
        "exact_text",
        "exact_text_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "VerifiedFinding": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/ResolvedCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "clarification_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Question"
        },
        "evidence_verdict": {
          "$ref": "#/$defs/EvidenceVerdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
          "title": "Finding Id",
          "type": "string"
        },
        "issue_type": {
          "$ref": "#/$defs/IssueType"
        },
        "origin": {
          "$ref": "#/$defs/AnalysisOrigin"
        },
        "proposed_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Revision"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "finding_id",
        "issue_type",
        "severity",
        "requirement_ids",
        "explanation",
        "citations",
        "evidence_verdict",
        "status",
        "origin"
      ],
      "title": "VerifiedFinding",
      "type": "object"
    },
    "WorkflowStatus": {
      "enum": [
        "RECEIVED",
        "VALIDATED",
        "ANALYZING",
        "VERIFYING",
        "NEEDS_REVIEW",
        "REVISION_REQUESTED",
        "APPROVED",
        "REJECTED",
        "BLOCKED",
        "ERROR",
        "EXPORTED"
      ],
      "title": "WorkflowStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clarification_questions": {
      "items": {
        "type": "string"
      },
      "title": "Clarification Questions",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/VerifiedFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/AnalysisProvenance"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/RevisionProposal"
      },
      "title": "Revisions",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Z][A-Z0-9-]{2,79}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "scorecard": {
      "$ref": "#/$defs/QualityScorecard"
    },
    "source_pack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Pack Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/WorkflowStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "manifest_sha256",
    "source_pack_sha256",
    "requirements",
    "findings",
    "revisions",
    "clarification_questions",
    "scorecard",
    "provenance"
  ],
  "title": "ReviewArtifact",
  "type": "object"
}
