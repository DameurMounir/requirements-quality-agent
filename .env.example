# The deterministic fixture adapter is the safe, provider-free default.
REQUIREMENTS_AGENT_PROVIDER=fixture
REQUIREMENTS_AGENT_REVIEWER_ID=demo-requirement-owner

# Optional live adapter. Never commit a real key.
OPENAI_API_KEY=replace-with-your-own-key
REQUIREMENTS_AGENT_MODEL=gpt-5.6-terra
REQUIREMENTS_AGENT_REASONING_EFFORT=low

